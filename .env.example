PORT=8200

MONGO_URI=mongodb://localhost:27017
MONGO_DB=yeshara

COMET_ENGINE_BASE_URL=http://localhost:8100
# Engine network every call is pinned to (X-Network): testnet or mainnet.
# Must match PAYMENTS_BASE_URL: testnet with the sandbox, mainnet with live.
COMET_ENGINE_NETWORK=testnet
COMET_API_KEY=
COMET_API_SECRET=

TREASURY_USER_ID=yeshara-treasury

ADMIN_TOKEN=

ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

PAYMENTS_BASE_URL=https://sandbox.payments.mamlakapsp.com/api/v1
PAYMENTS_MERCHANT_ID=
PAYMENTS_CALLBACK_URL=
PAYMENTS_CALLBACK_SECRET=
USD_KES_RATE=129

# Password reset emails. APP_PUBLIC_URL is the frontend the link opens.
# Without SMTP_HOST no email is sent; outside APP_ENV=production the link is
# logged instead so it can be tested locally.
APP_ENV=development
APP_PUBLIC_URL=https://yeshara-marketplace.vercel.app
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Yeshara <no-reply@yeshara.network>
